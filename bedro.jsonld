  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "de",
    "@value" : "Ontologie für die Implementierung von deutschen Brückenentwurfsregeln."
  }, {
    "@language" : "en",
    "@value" : "Ontology for the implementation of German design rules for bridges and bridge components."
  } ],
