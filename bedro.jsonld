  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "is an alternative design of one bridge"
  }, {
    "@language" : "de",
    "@value" : "ist eine Entwurfsvariante einer Brücke"
  } ],
