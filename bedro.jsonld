  } ]
}, {
  "@id" : "https://w3id.org/bcore/lifecycle#Project",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A project is a type of assignment, typically involving research or design, that is carefully planned to achieve a specific objective. (https://en.wikipedia.org/wiki/Project)"
  }, {
    "@language" : "de",
    "@value" : "Ein Projekt ist ein zielgerichtetes, einmaliges Vorhaben, das aus einem Satz von abgestimmten, gesteuerten Tätigkeiten besteht und durchgeführt werden kann, um unter Berücksichtigung von Vorgaben wie etwa Zeit, Ressourcen und Qualität ein Ziel zu erreichen. (Quelle: https://de.wikipedia.org/wiki/Projekt)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Projekt"
  }, {
    "@language" : "en",
    "@value" : "project"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ]
}, {
  "@id" : "https://w3id.org/bcore/lifecycle#ProjectName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Name of the project"
  }, {
    "@language" : "de",
    "@value" : "Name/Bezeichnung des Projekts"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/bcore/lifecycle#Project"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Projektname"
  }, {
    "@language" : "en",
    "@value" : "project name"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/bcore/lifecycle#hasVariant",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "a bridge has at least one alternative design"
  }, {
    "@language" : "de",
    "@value" : "eine Brücke hat mindestens eine Entwurfsvariante"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/brot#Bridge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has variant"
  }, {
    "@language" : "de",
    "@value" : "hat Variante"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/bcore/lifecycle#BridgeVariant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#topObjectProperty"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/bcore/lifecycle#isVariantOf"
  } ]
}, {
  "@id" : "https://w3id.org/bcore/lifecycle#isCreatedInProject",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Zone, especially Building, Site or Bridge is raised in one Project"
  }, {
    "@language" : "de",
    "@value" : "Zone, vor allem Gebäude, Baustelle oder Brücke, wird in einem Projekt erstellt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/bot#Zone"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is created in project"
  }, {
    "@language" : "de",
    "@value" : "wird in Projekt errichtet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/bcore/lifecycle#Project"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#topObjectProperty"
  } ]
}, {
  "@id" : "https://w3id.org/bcore/lifecycle#isUsedInProject",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "InfrastructureRoute, is used and often edited/changed in one Project"
  }, {
    "@language" : "de",
    "@value" : "InfrastructureRoute, wird in einem Projekt genutzt und oft auch bearbeitet/geändert"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/bcore#InfrastructureRoute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is used in project"
  }, {
    "@language" : "de",
    "@value" : "wird in Projekt verwendet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/bcore/lifecycle#Project"
  } ]
}, {
