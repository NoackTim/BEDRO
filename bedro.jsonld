  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Areal, auf dem eine Bautätigkeit ausgeübt wird."
  }, {
    "@language" : "en",
    "@value" : "building site"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Baustelle"
  }, {
