}, {
  "@id" : "https://w3id.org/bedro",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/abstract" : [ {
    "@language" : "de",
    "@value" : "Diese Ontologie dient der strukturierten Implementierung von Entwurfsregeln für Brückenbauteile für die frühen Phasen des Brückenentwurfs."
  }, {
    "@language" : "en",
    "@value" : "This ontology is structuring bridge desing rules for the dimensioning of bridge components in the early phases of bridge design."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "de",
    "@value" : "Ontologie für die Strukturierung von Brückenentwurfsregeln"
  }, {
    "@language" : "en",
    "@value" : "Ontology for structuring design rules for bridge components"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-08-01"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Tim Noack"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "de",
    "@value" : "Ontologie für die Implementierung von deutschen Brückenentwurfsregeln."
  }, {
    "@language" : "en",
    "@value" : "Ontology for the implementation of German design rules for bridges and bridge components."
  } ],
  "http://purl.org/dc/terms/license" : [ {
