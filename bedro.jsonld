}, {
  "@id" : "https://w3id.org/bedro",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/abstract" : [ {
    "@language" : "de",
    "@value" : "Diese Ontologie dient der strukturierten Implementierung von Entwurfsregeln für Brückenbauteile für die frühen Phasen des Brückenentwurfs."
  }, {
    "@language" : "en",
    "@value" : "This ontology is structuring bridge desing rules for the dimensioning of bridge components in the early phases of bridge design."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "de",
    "@value" : "Ontologie für die Strukturierung von Brückenentwurfsregeln"
  }, {
    "@language" : "en",
    "@value" : "Ontology for structuring design rules for bridge components"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-08-01"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Tim Noack"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "de",
    "@value" : "Ontologie für die Implementierung von deutschen Brückenentwurfsregeln."
  }, {
    "@language" : "en",
    "@value" : "Ontology for the implementation of German design rules for bridges and bridge components."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "https://creativecommons.org/licenses/by/4.0/deed.en"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-07"
  } ],
  "http://purl.org/ontology/bibo/status" : [ {
    "@language" : "en",
    "@value" : "Ontology Specification Draft"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "bedro"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Bridge Element Design Rule Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/bcore"
  }, {
    "@id" : "https://w3id.org/bcore/comp"
