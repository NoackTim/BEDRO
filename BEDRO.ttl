@prefix : <https://w3id.org/BEDRO#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/BEDRO#> .

<https://w3id.org/BEDRO> rdf:type owl:Ontology ;
                          owl:imports <https://w3id.org/BCore> ;
                          <http://purl.org/dc/elements/1.1/abstract> "This ontology is structuring bridge desing rules for the dimensioning of bridge components in the early phases of bridge design."@en ;
                          <http://purl.org/dc/elements/1.1/title> "Ontology for structuring design rules for bridge components"@en ;
                          <http://purl.org/dc/terms/created> "2025-08-01"^^xsd:date ;
                          <http://purl.org/dc/terms/creator> "Tim Noack" ;
                          rdfs:label "Bridge Element Design Rule Ontology" ;
                          owl:versionInfo "0.0.1" ;
                          <https://w3id.org/BCore#vann:preferredNamespacePrefix> "BEDRO" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/abstract
<http://purl.org/dc/elements/1.1/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  https://w3id.org/BCore#vann:preferredNamespacePrefix
<https://w3id.org/BCore#vann:preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/BCore#carriesRoute
<https://w3id.org/BCore#carriesRoute> rdf:type owl:ObjectProperty .


###  https://w3id.org/BCore#crossesRoute
<https://w3id.org/BCore#crossesRoute> rdf:type owl:ObjectProperty .


###  https://w3id.org/BCore#locatedInZone
<https://w3id.org/BCore#locatedInZone> rdf:type owl:ObjectProperty .


###  https://w3id.org/BCore#partOfRoute
<https://w3id.org/BCore#partOfRoute> rdf:type owl:ObjectProperty .


###  https://w3id.org/BCore#partOfZone
<https://w3id.org/BCore#partOfZone> rdf:type owl:ObjectProperty .


###  https://w3id.org/BEDRO#equalsRoutePoint
:equalsRoutePoint rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdf:type owl:SymmetricProperty ;
                  rdfs:domain <https://w3id.org/BCore#RoutePoint> .


###  https://w3id.org/BEDRO#runsToTheLeftOf
:runsToTheLeftOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain <https://w3id.org/BCore#FootCycleRoute> ;
                 rdfs:range <https://w3id.org/BCore#RoadRoute> .


###  https://w3id.org/BEDRO#runsToTheRightOf
:runsToTheRightOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain <https://w3id.org/BCore#FootCycleRoute> ;
                  rdfs:range <https://w3id.org/BCore#RoadRoute> .


###  https://w3id.org/brot#containsComponent
<https://w3id.org/brot#containsComponent> rdf:type owl:ObjectProperty .


###  https://w3id.org/reloc#meetBottom
<https://w3id.org/reloc#meetBottom> rdf:type owl:ObjectProperty .


###  https://w3id.org/reloc#meetLeft
<https://w3id.org/reloc#meetLeft> rdf:type owl:ObjectProperty .


###  https://w3id.org/reloc#meetRight
<https://w3id.org/reloc#meetRight> rdf:type owl:ObjectProperty .


###  https://w3id.org/reloc#meetTop
<https://w3id.org/reloc#meetTop> rdf:type owl:ObjectProperty .


