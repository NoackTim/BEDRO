[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Ist die Maximalgeschwindigkeit der Eisenbahnstrecke größer als 200 km/h, so ist das Lichtraumprofil (ohne Überhöhung) mindestens 7.40m hoch. (RE-ING Teil 2-1 Anhang A)" ;
   rdfs:label "RailwayClearanceHeight>200km/h" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/BCore#RailwayRoute> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/BEDRO/r>
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :RailwayMaximumVelocity ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/BEDRO/r> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <https://w3id.org/BEDRO/v>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#greaterThan> ;
                                                                             <http://www.w3.org/2003/11/swrl#arguments> [ rdf:type rdf:List ;
                                                                                                                          rdf:first <https://w3id.org/BEDRO/v> ;
                                                                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                                                                     rdf:first 200 ;
                                                                                                                                     rdf:rest rdf:nil
                                                                                                                                   ]
                                                                                                                        ]
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :InfrastructureRouteClearanceHeight ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/BEDRO/r> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> 7.40
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Liegt die Maximalgeschwindigkeit der Eisenbahnstrecke zwischen 160 und 200 km/h, so ist das Lichtraumprofil (ohne Überhöhung) mindestens 5,90m hoch. (RE-ING Teil 2-1)" ;
   rdfs:label "RailwayClearanceHeight160<v<=200km/h" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/BCore#RailwayRoute> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/BEDRO/r>
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :RailwayMaximumVelocity ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/BEDRO/r> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <https://w3id.org/BEDRO/v>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ;
                                                                             <http://www.w3.org/2003/11/swrl#arguments> [ rdf:type rdf:List ;
                                                                                                                          rdf:first <https://w3id.org/BEDRO/v> ;
                                                                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                                                                     rdf:first 200 ;
                                                                                                                                     rdf:rest rdf:nil
                                                                                                                                   ]
                                                                                                                        ]
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#greaterThan> ;
                                                                                        <http://www.w3.org/2003/11/swrl#arguments> [ rdf:type rdf:List ;
                                                                                                                                     rdf:first <https://w3id.org/BEDRO/v> ;
                                                                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                rdf:first 160 ;
                                                                                                                                                rdf:rest rdf:nil
                                                                                                                                              ]
                                                                                                                                   ]
                                                                                      ] ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :InfrastructureRouteClearanceHeight ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/BEDRO/r> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> 5.90
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Ist die Straße ein Wirtschaftsweg, so ist das Lichtraumprofil 4,50m hoch und 5,00m breit. (RE-ING Teil 2-1)" ;
   rdfs:label "RoadClearanceHeightAgriculturalRoad" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/BCore#RoadRoute> ;
