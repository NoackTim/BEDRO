[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Wenn zwei Punkte aus unterschiedlichen Trassen an derselben Stelle liegen (unabhängig von ihrer Höhe), dann sind sie \"gleich\" und die Trassen kreuzen sich." ;
   rdfs:label "RouteCrossing" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/BCore#InfrastructureRoute> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/BEDRO/r1>
