<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/bedro#"
     xml:base="https://w3id.org/bedro"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:bmat="https://w3id.org/bmat#"
     xmlns:brot="https://w3id.org/brot#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:bcore="https://w3id.org/bcore#"
     xmlns:bedro="https://w3id.org/bedro#"
     xmlns:reloc="https://w3id.org/reloc#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:brcomp="https://w3id.org/brcomp#"
     xmlns:schema="https://schema.org/"
     xmlns:schema1="http://schema.org/"
     xmlns:bcoremat="https://w3id.org/bcore/mat#"
     xmlns:bcorecomp="https://w3id.org/bcore/comp#"
     xmlns:bcoreinfra="https://w3id.org/bcore/infra#"
     xmlns:bcorezones="https://w3id.org/bcore/zones#"
     xmlns:infraspatialot="https://dtc-ontology.cms.ed.tum.de/infraspatialot#">
    <owl:Ontology rdf:about="https://w3id.org/bedro">
        <owl:imports rdf:resource="https://w3id.org/bcore"/>
        <owl:imports rdf:resource="https://w3id.org/bcore/comp"/>
        <owl:imports rdf:resource="https://w3id.org/bcore/infra"/>
        <owl:imports rdf:resource="https://w3id.org/bcore/mat"/>
        <owl:imports rdf:resource="https://w3id.org/bcore/zones"/>
        <dc:abstract xml:lang="de">Diese Ontologie dient der strukturierten Implementierung von Entwurfsregeln für Brückenbauteile für die frühen Phasen des Brückenentwurfs.</dc:abstract>
        <dc:abstract xml:lang="en">This ontology is structuring bridge desing rules for the dimensioning of bridge components in the early phases of bridge design.</dc:abstract>
        <dc:title xml:lang="de">Ontologie für die Strukturierung von Brückenentwurfsregeln</dc:title>
        <dc:title xml:lang="en">Ontology for structuring design rules for bridge components</dc:title>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-01</terms:created>
        <terms:creator>Tim Noack</terms:creator>
        <terms:description xml:lang="de">Ontologie für die Implementierung von deutschen Brückenentwurfsregeln.</terms:description>
        <terms:description xml:lang="en">Ontology for the implementation of German design rules for bridges and bridge components.</terms:description>
        <terms:license>https://creativecommons.org/licenses/by/4.0/deed.en</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <bibo:status xml:lang="en">Ontology Specification Draft</bibo:status>
        <vann:preferredNamespacePrefix>bedro</vann:preferredNamespacePrefix>
        <rdfs:label>Bridge Element Design Rule Ontology</rdfs:label>
        <owl:versionInfo>0.1.6</owl:versionInfo>
        <schema:codeRepository>https://github.com/NoackTim/BEDRO</schema:codeRepository>
    </owl:Ontology>
    


