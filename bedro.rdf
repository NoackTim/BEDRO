                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#b3"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#add"/>
                                                        <swrl:arguments rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="https://w3id.org/bedro#bges"/>
                                                            <rdf:Description rdf:about="https://w3id.org/bedro#b2"/>
                                                            <rdf:Description rdf:about="https://w3id.org/bedro#b3"/>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
