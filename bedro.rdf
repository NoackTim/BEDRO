        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Is the construction of a bridge superstructure not recommended at this location?</rdfs:comment>
        <rdfs:comment xml:lang="de">Ist hier die Errichtung einer Stütze nicht empfohlen?</rdfs:comment>
        <rdfs:label xml:lang="de">Stützung nicht empfohlen</rdfs:label>
        <rdfs:label xml:lang="en">support not recommended</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#TRBxxXXb00 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#TRBxxXXb00">
