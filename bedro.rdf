                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#b02"/>
                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#b08"/>
                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#b09"/>
                                                                                                </swrl:arguments>
