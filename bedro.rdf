        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Is the construction of a bridge superstructure not possible at this location?</rdfs:comment>
        <rdfs:comment xml:lang="de">Lässt sich hier keine Stütze errichten?</rdfs:comment>
        <rdfs:label xml:lang="de">Stützung nicht möglich</rdfs:label>
        <rdfs:label xml:lang="en">support not possible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#SupportNotRecommended -->

