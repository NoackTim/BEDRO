    </owl:Class>
    


    <!-- https://w3id.org/bcore/lifecycle#ConstructionProject -->

    <owl:Class rdf:about="https://w3id.org/bcore/lifecycle#ConstructionProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/lifecycle#Project"/>
        <rdfs:comment xml:lang="en">Project with the aim to raise or adapt a building or structure</rdfs:comment>
        <rdfs:comment xml:lang="de">Projekt mit dem Ziel der Errichtung oder Anpassung eines Bauwerks</rdfs:comment>
        <rdfs:label xml:lang="de">Bauprojekt</rdfs:label>
        <rdfs:label xml:lang="en">construction project</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/lifecycle#Project -->

    <owl:Class rdf:about="https://w3id.org/bcore/lifecycle#Project">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">A project is a type of assignment, typically involving research or design, that is carefully planned to achieve a specific objective. (https://en.wikipedia.org/wiki/Project)</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein Projekt ist ein zielgerichtetes, einmaliges Vorhaben, das aus einem Satz von abgestimmten, gesteuerten Tätigkeiten besteht und durchgeführt werden kann, um unter Berücksichtigung von Vorgaben wie etwa Zeit, Ressourcen und Qualität ein Ziel zu erreichen. (Quelle: https://de.wikipedia.org/wiki/Projekt)</rdfs:comment>
        <rdfs:label xml:lang="de">Projekt</rdfs:label>
        <rdfs:label xml:lang="en">project</rdfs:label>
    </owl:Class>
    


