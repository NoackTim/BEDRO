        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#TrafficBarrier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Breite der Schutzeinrichtung</rdfs:comment>
        <rdfs:comment xml:lang="en">Width of the traffic barrier</rdfs:comment>
        <rdfs:label xml:lang="de">Fahrzeugrückhaltesystem Breite</rdfs:label>
        <rdfs:label xml:lang="en">traffic barrier width</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXf00 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXf00">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Colour of the component</rdfs:comment>
        <rdfs:comment xml:lang="de">Farbe des Bauteils</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteilfarbe</rdfs:label>
        <rdfs:label xml:lang="en">component color</rdfs:label>
        <schema:unitText>Declaration in words (e.g. &quot;blue&quot; or &quot;dark green&quot;) or Hex-Code (&quot;#0000ff&quot; or &quot;#008800&quot;)</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXp00 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXp00">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="de">Position des Bauteils horizontal senkrecht zur Trasse (Index)</rdfs:comment>
        <rdfs:comment xml:lang="en">Position of the component horizontally perpendicular to the alignment (index)</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteil transversale Position</rdfs:label>
        <rdfs:label xml:lang="en">component transversal position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXq00 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXq00">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Normal distance of the component cross section&apos;s reference point transversal to alignment (positive to the right)/ Offset of the bridge&apos;s axis</rdfs:comment>
        <rdfs:comment xml:lang="de">Normaldistanz des Referenzpunkts des Bauteilquerschnitts zur Trasse (positiv nach rechts)</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteil transversaler Versatz</rdfs:label>
        <rdfs:label xml:lang="en">component axis offset</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXs01 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXs01">
