    <!-- https://w3id.org/bedro#SupportNotPossible -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#SupportNotPossible">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Is the construction of a bridge superstructure not possible at this location?</rdfs:comment>
