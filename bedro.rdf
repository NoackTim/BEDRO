    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>DE: Wenn Kappe und Lärmschutzwand rechts auf einer Brücke liegen, ist die Wand direkt über der Kappe positioniert.; EN: If the cap and the noise barrier on the right side of a bridge, the barrier is positioned directly above the cap.</rdfs:comment>
        <rdfs:label>CAP99meetNOB99</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
