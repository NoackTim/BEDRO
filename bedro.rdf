    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>DE: Neigung 2 der Plattenbrücke ist immer so groß wie Neigung 3 der rechten Kappe, gleiches gilt für SLb02=CAP99XXb04. EN: Inclination 2 of the slab is always equal to inclination 3 of the right cap, the same applies to SLb02=CAP99XXb04.</rdfs:comment>
        <rdfs:label>SUP00SL_CAP99</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
