    <!-- https://w3id.org/bcore#carriesRoute -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#carriesRoute"/>
    


    <!-- https://w3id.org/bcore#crossesRoute -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#crossesRoute"/>
    


    <!-- https://w3id.org/bedro#equalsRoutePoint -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bedro#equalsRoutePoint">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:comment xml:lang="de">Punkt gleicht anderem Punkt in X- und Y-Koordinaten, nicht unbeding in Z-Koordinaten</rdfs:comment>
        <rdfs:comment xml:lang="en">route point equals other point in X- and Y-coordinates but not necessarily in Z-coordinate</rdfs:comment>
        <rdfs:label xml:lang="en">equals route point</rdfs:label>
        <rdfs:label xml:lang="de">ist äquivalent zu Trassenpunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bedro#runsToTheLeftOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bedro#runsToTheLeftOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/bedro#runsToTheRightOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Die Infrastrukturtrasse verläuft parallel zu einer anderen Trasse, in Trassierungsrichtung links davon.</rdfs:comment>
        <rdfs:comment xml:lang="en">The infrastructure route runs parallely to another route, in direction of the route left of it.</rdfs:comment>
        <rdfs:label xml:lang="en">runs to the left of</rdfs:label>
        <rdfs:label xml:lang="de">verläuft links von</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bedro#runsToTheRightOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bedro#runsToTheRightOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Die Infrastrukturtrasse verläuft parallel zu einer anderen Trasse, in Trassierungsrichtung rechts davon.</rdfs:comment>
        <rdfs:comment xml:lang="en">The infrastructure route runs parallely to another route, in direction of the route right of it.</rdfs:comment>
        <rdfs:label xml:lang="en">runs to the right of</rdfs:label>
        <rdfs:label xml:lang="de">verläuft rechts von</rdfs:label>
    </owl:ObjectProperty>
    


