    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore#carriesRoute -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#carriesRoute"/>
    


    <!-- https://w3id.org/bcore#crossesRoute -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#crossesRoute"/>
    


    <!-- https://w3id.org/bcore#hasWayPointAt -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#hasWayPointAt"/>
    


    <!-- https://w3id.org/bcore#isWayPointOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isWayPointOf"/>
    


    <!-- https://w3id.org/bcore/lifecycle#hasVariant -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/lifecycle#hasVariant">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/bcore/lifecycle#isVariantOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/lifecycle#BridgeVariant"/>
        <rdfs:comment xml:lang="en">a bridge has at least one alternative design</rdfs:comment>
        <rdfs:comment xml:lang="de">eine Brücke hat mindestens eine Entwurfsvariante</rdfs:comment>
        <rdfs:label xml:lang="en">has variant</rdfs:label>
        <rdfs:label xml:lang="de">hat Variante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/lifecycle#isCreatedInProject -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/lifecycle#isCreatedInProject">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/lifecycle#Project"/>
        <rdfs:comment xml:lang="en">Zone, especially Building, Site or Bridge is raised in one Project</rdfs:comment>
        <rdfs:comment xml:lang="de">Zone, vor allem Gebäude, Baustelle oder Brücke, wird in einem Projekt erstellt</rdfs:comment>
        <rdfs:label xml:lang="en">is created in project</rdfs:label>
        <rdfs:label xml:lang="de">wird in Projekt errichtet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/lifecycle#isUsedInProject -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/lifecycle#isUsedInProject">
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/lifecycle#Project"/>
        <rdfs:comment xml:lang="en">InfrastructureRoute, is used and often edited/changed in one Project</rdfs:comment>
        <rdfs:comment xml:lang="de">InfrastructureRoute, wird in einem Projekt genutzt und oft auch bearbeitet/geändert</rdfs:comment>
        <rdfs:label xml:lang="en">is used in project</rdfs:label>
        <rdfs:label xml:lang="de">wird in Projekt verwendet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/lifecycle#isVariantOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/lifecycle#isVariantOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/lifecycle#BridgeVariant"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="en">is an alternative design of one bridge</rdfs:comment>
        <rdfs:comment xml:lang="de">ist eine Entwurfsvariante einer Brücke</rdfs:comment>
        <rdfs:label xml:lang="en">is variant of</rdfs:label>
        <rdfs:label xml:lang="de">ist Variante von</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bedro#equalsWayPoint -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bedro#equalsWayPoint">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#WayPoint"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#WayPoint"/>
        <rdfs:comment xml:lang="de">Punkt gleicht anderem Punkt in X- und Y-Koordinaten, nicht unbeding in Z-Koordinaten</rdfs:comment>
        <rdfs:comment xml:lang="en">way point equals other point in X- and Y-coordinates but not necessarily in Z-coordinate</rdfs:comment>
        <rdfs:label xml:lang="en">equals way point</rdfs:label>
        <rdfs:label xml:lang="de">ist äquivalent zu Wegpunkt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bedro#runsToTheLeftOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bedro#runsToTheLeftOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/bedro#runsToTheRightOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Die Infrastrukturtrasse verläuft parallel zu einer anderen Trasse, in Trassierungsrichtung links davon.</rdfs:comment>
        <rdfs:comment xml:lang="en">The infrastructure route runs parallely to another route, in direction of the route left of it.</rdfs:comment>
        <rdfs:label xml:lang="en">runs to the left of</rdfs:label>
        <rdfs:label xml:lang="de">verläuft links von</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bedro#runsToTheRightOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bedro#runsToTheRightOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Die Infrastrukturtrasse verläuft parallel zu einer anderen Trasse, in Trassierungsrichtung rechts davon.</rdfs:comment>
        <rdfs:comment xml:lang="en">The infrastructure route runs parallely to another route, in direction of the route right of it.</rdfs:comment>
        <rdfs:label xml:lang="en">runs to the right of</rdfs:label>
        <rdfs:label xml:lang="de">verläuft rechts von</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brot#containsComponent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brot#containsComponent"/>
    


    <!-- https://w3id.org/reloc#meetBottom -->

    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetBottom"/>
    


    <!-- https://w3id.org/reloc#meetLeft -->

    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetLeft"/>
    


    <!-- https://w3id.org/reloc#meetRight -->

    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetRight"/>
    


    <!-- https://w3id.org/reloc#meetTop -->

    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetTop"/>
    


