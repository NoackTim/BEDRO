                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#subtract"/>
                                                                <swrl:arguments rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#b4"/>
                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#bges"/>
                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#b1"/>
                                                                </swrl:arguments>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
