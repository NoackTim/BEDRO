                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#multiply"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="https://w3id.org/bedro#b3"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:resource="https://w3id.org/bedro#h3"/>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#CAPxxXXb03"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#c"/>
                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#b3"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>DE: Die Breite der Brücke berechnet sich aus der Summe der Breiten vom Fahrbahnbelag und den beiden Kappen.; EN: The width of the bridge is calculated as the sum of the widths of the pavement and the two caps.</rdfs:comment>
        <rdfs:label>Bridge_Width</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/brot#Bridge"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#b"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/brot#containsComponent"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#b"/>
                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#cl"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="https://w3id.org/brcomp#Cap"/>
                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#cl"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#XXXxxXXp00"/>
                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#cl"/>
                                                <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</swrl:argument2>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#CAPxxXXb02"/>
                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#cl"/>
                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#bl2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#CAPxxXXb03"/>
                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#cl"/>
                                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#bl3"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/brot#containsComponent"/>
                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#b"/>
                                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#cr"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                <swrl:classPredicate rdf:resource="https://w3id.org/brcomp#Cap"/>
                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#cr"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#XXXxxXXp00"/>
                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#cr"/>
                                                                                        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">99</swrl:argument2>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                        <rdf:first>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#CAPxxXXb02"/>
                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#cr"/>
                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#br2"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                <rdf:first>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#CAPxxXXb03"/>
                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#cr"/>
                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#br3"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                        <rdf:first>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/brot#containsComponent"/>
                                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#b"/>
                                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#p"/>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:first>
                                                                                                        <rdf:rest>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                <rdf:first>
                                                                                                                    <rdf:Description>
                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                                                        <swrl:classPredicate rdf:resource="https://w3id.org/brcomp#Pavement"/>
                                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#p"/>
                                                                                                                    </rdf:Description>
                                                                                                                </rdf:first>
                                                                                                                <rdf:rest>
                                                                                                                    <rdf:Description>
                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                        <rdf:first>
                                                                                                                            <rdf:Description>
                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#PAV00XXb01"/>
                                                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#p"/>
                                                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#bp1"/>
                                                                                                                            </rdf:Description>
                                                                                                                        </rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                            <rdf:Description>
                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                                <rdf:first>
                                                                                                                                    <rdf:Description>
                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#PAV00XXb02"/>
                                                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#p"/>
                                                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#bp2"/>
                                                                                                                                    </rdf:Description>
                                                                                                                                </rdf:first>
                                                                                                                                <rdf:rest>
                                                                                                                                    <rdf:Description>
                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                                        <rdf:first>
                                                                                                                                            <rdf:Description>
                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                                                                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#add"/>
                                                                                                                                                <swrl:arguments rdf:parseType="Collection">
                                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#bb"/>
                                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#br2"/>
                                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#br3"/>
                                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#bl2"/>
                                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#bl3"/>
                                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#bp1"/>
                                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/bedro#bp2"/>
                                                                                                                                                </swrl:arguments>
                                                                                                                                            </rdf:Description>
                                                                                                                                        </rdf:first>
                                                                                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                    </rdf:Description>
                                                                                                                                </rdf:rest>
                                                                                                                            </rdf:Description>
                                                                                                                        </rdf:rest>
                                                                                                                    </rdf:Description>
                                                                                                                </rdf:rest>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:rest>
                                                                                                    </rdf:Description>
                                                                                                </rdf:rest>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bedro#BridgeWidth"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#b"/>
                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#bb"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>DE: Wenn zwei Punkte aus unterschiedlichen Trassen an derselben Stelle liegen (unabhängig von ihrer Höhe), dann sind sie &quot;gleich&quot; und die Trassen kreuzen sich; EN: If two points on different routes lie at the same location (regardless of their elevation), then they are “equal” and the routes cross.</rdfs:comment>
        <rdfs:label>BC_RouteCrossing</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#r2"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bcore#InfrastructureRouteName"/>
                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#r1"/>
                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#n1"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#notEqual"/>
                                                <swrl:arguments rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://w3id.org/bedro#n1"/>
                                                    <rdf:Description rdf:about="https://w3id.org/bedro#n2"/>
                                                </swrl:arguments>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bcore#InfrastructureRouteName"/>
                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#r2"/>
                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#n2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                <swrl:classPredicate rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation"/>
                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#LL1"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bcore#isPartOfRoute"/>
                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#LL1"/>
                                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#r1"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/bcore#hasWayPointAt"/>
                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#LL1"/>
                                                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#wp1"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                        <swrl:classPredicate rdf:resource="https://w3id.org/bcore#WayPoint"/>
                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#wp1"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                        <rdf:first>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                                <swrl:classPredicate rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation"/>
                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#LL2"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                <rdf:first>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/bcore#isPartOfRoute"/>
                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#LL2"/>
                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#r2"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                        <rdf:first>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/bcore#hasWayPointAt"/>
                                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#LL2"/>
                                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#wp2"/>
