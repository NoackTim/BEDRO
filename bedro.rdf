                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                        <swrl:classPredicate rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation"/>
                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#LL2"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
