    <!-- https://w3id.org/bedro#BridgeOntologyParameter -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#BridgeOntologyParameter">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="en">Parameter following the Bridge Ontology Parametercoding (BOP) convention, developed at the Institute of Concrete Structures, Technische Universität Dresden. The parameters define geometric and other attributes of bridge components. Each parameter is coded with a ten-character alphanumeric code: AAAbbCCdEE (A: component, b: transversal position, C: sub-component, d: attribute type, E: attribute number). X or 00 means global [applies for every (sub-)component/ attribute of that kind].</rdfs:comment>
        <rdfs:comment xml:lang="de">Parameter, der der Bridge Ontology Parametercoding (BOP) Namenskonvention folgt, die am Institut für Massivbau, Technische Universität Dresden, entwickelt wurde. Die Parameter definieren geometrische und weitere Attribute von Brückenbauteilen. Jeder Parameter ist mit einem zehnstelligen alphanumerischen Code beschrieben: AAAbbCCdEE (A: Bauteil, b: transversale Position, C: Teilbauteil, d: Art des Attributs, E: Nummer des Attributs). X oder 00 bedeutet global [gilt für alle (Teil-)Bauteile/Attribute dieser Art].</rdfs:comment>
        <rdfs:label xml:lang="de">Brückenontologieparameter</rdfs:label>
        <rdfs:label xml:lang="en">bridge ontology parameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#BridgeWidth -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#BridgeWidth">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Gesamtbreite des Regelquerschnitts der Brücke</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge width/ bridge broadth</rdfs:comment>
        <rdfs:label xml:lang="de">Brückenbreite</rdfs:label>
        <rdfs:label xml:lang="en">bridge width</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


