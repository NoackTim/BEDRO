                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/bcore#WayPointStation"/>
                                                                                <swrl:argument1 rdf:resource="https://w3id.org/bedro#wp1"/>
                                                                                <swrl:argument2 rdf:resource="https://w3id.org/bedro#s1"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
