        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Kilometrierung des Bauteilbeginns (Stationierung)</rdfs:comment>
        <rdfs:comment xml:lang="en">Station of the component beginning (kilometer of route)</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteilstationierung Start</rdfs:label>
        <rdfs:label xml:lang="en">component station start</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXs02 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXs02">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Kilometrierung des Bauteilendes (Stationierung)</rdfs:comment>
        <rdfs:comment xml:lang="en">Station of the component ending (kilometer of route)</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteilstationierung Ende</rdfs:label>
        <rdfs:label xml:lang="en">component station end</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXz01 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXz01">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Altitude of the component beginning</rdfs:comment>
        <rdfs:comment xml:lang="de">Höhe des Bauteilanfangs über NN</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteilkote Start</rdfs:label>
        <rdfs:label xml:lang="en">component altitude start</rdfs:label>
        <schema:unitText>m AMSL</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXz02 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXz02">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Altitude of the component ending</rdfs:comment>
        <rdfs:comment xml:lang="de">Höhe des Bauteilendes über NN</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteilkote Ende</rdfs:label>
        <rdfs:label xml:lang="en">component altitude end</rdfs:label>
        <schema:unitText>m AMSL</schema:unitText>
    </owl:DatatypeProperty>
    


