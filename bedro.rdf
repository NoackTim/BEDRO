     -->

    


    <!-- https://w3id.org/bcore#InfrastructureRouteName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#InfrastructureRouteName"/>
    


    <!-- https://w3id.org/bcore#InfrastructureRouteWidth -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#InfrastructureRouteWidth"/>
    


    <!-- https://w3id.org/bcore#LocalX -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#LocalX"/>
    


    <!-- https://w3id.org/bcore#LocalY -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#LocalY"/>
    


    <!-- https://w3id.org/bcore#WayPointEnvironmentZ -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#WayPointEnvironmentZ">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#WayPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Z-Koordinate der Umgebung unter oder über dem Wegpunkt</rdfs:comment>
        <rdfs:comment xml:lang="en">Z-coordinate of the environment under or above the waypoint</rdfs:comment>
        <rdfs:label xml:lang="de">Wegpunkt Umgebung Z</rdfs:label>
        <rdfs:label xml:lang="en">waypoint environment Z</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#WayPointStation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#WayPointStation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#WayPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Kilometrierung des Wegpunktes auf der Trasse</rdfs:comment>
        <rdfs:comment xml:lang="en">kilometer marking of the waypoint on the route</rdfs:comment>
        <rdfs:label xml:lang="de">Wegpunkt Stationierung</rdfs:label>
        <rdfs:label xml:lang="en">waypoint station</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/lifecycle#BridgeVariantName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/lifecycle#BridgeVariantName">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/lifecycle#BridgeVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Name des alternativen Brückenentwurfs</rdfs:comment>
        <rdfs:comment xml:lang="en">name of the alternative bridge design</rdfs:comment>
        <rdfs:label xml:lang="de">Name der Brückenvariante</rdfs:label>
        <rdfs:label xml:lang="en">bridge variant name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/lifecycle#ProjectName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/lifecycle#ProjectName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/lifecycle#Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the project</rdfs:comment>
        <rdfs:comment xml:lang="de">Name/Bezeichnung des Projekts</rdfs:comment>
        <rdfs:label xml:lang="de">Projektname</rdfs:label>
        <rdfs:label xml:lang="en">project name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#BridgeOntologyParameter -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#BridgeOntologyParameter">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#boolean"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#decimal"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Parameter following the Bridge Ontology Parametercoding (BOP) convention, developed at the Institute of Concrete Structures, Technische Universität Dresden. The parameters define geometric and other attributes of bridge components. Each parameter is coded with a ten-character alphanumeric code: AAAbbCCdEE (A: component, b: transversal position, C: sub-component, d: attribute type, E: attribute number). X or 00 means global [applies for every (sub-)component/ attribute of that kind].</rdfs:comment>
        <rdfs:comment xml:lang="de">Parameter, der der Bridge Ontology Parametercoding (BOP) Namenskonvention folgt, die am Institut für Massivbau, Technische Universität Dresden, entwickelt wurde. Die Parameter definieren geometrische und weitere Attribute von Brückenbauteilen. Jeder Parameter ist mit einem zehnstelligen alphanumerischen Code beschrieben: AAAbbCCdEE (A: Bauteil, b: transversale Position, C: Teilbauteil, d: Art des Attributs, E: Nummer des Attributs). X oder 00 bedeutet global [gilt für alle (Teil-)Bauteile/Attribute dieser Art].</rdfs:comment>
        <rdfs:label xml:lang="de">Brückenontologieparameter</rdfs:label>
        <rdfs:label xml:lang="en">bridge ontology parameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#BridgeWidth -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#BridgeWidth">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Gesamtbreite des Regelquerschnitts der Brücke</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge width/ bridge broadth</rdfs:comment>
        <rdfs:label xml:lang="de">Brückenbreite</rdfs:label>
        <rdfs:label xml:lang="en">bridge width</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#CAPxxCUe00 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#CAPxxCUe00">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Cap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Existence of the curb at the cap</rdfs:comment>
        <rdfs:comment xml:lang="de">Existenz des Schrammbords der Kappe</rdfs:comment>
        <rdfs:label xml:lang="de">Schrammbord Existenz</rdfs:label>
        <rdfs:label xml:lang="en">curb existence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#CAPxxXXb01 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#CAPxxXXb01">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Cap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Breite 1 der Kappe</rdfs:comment>
        <rdfs:comment xml:lang="en">Width 1 of the cap</rdfs:comment>
        <rdfs:label xml:lang="de">Kappe Breite 1</rdfs:label>
        <rdfs:label xml:lang="en">cap width 1</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#CAPxxXXb02 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#CAPxxXXb02">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Cap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Breite 2 der Kappe</rdfs:comment>
        <rdfs:comment xml:lang="en">Width 2 of the cap</rdfs:comment>
        <rdfs:label xml:lang="de">Kappe Breite 2</rdfs:label>
        <rdfs:label xml:lang="en">cap width 2</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#CAPxxXXb03 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#CAPxxXXb03">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bedro#BridgeOntologyParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Cap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Breite 3 der Kappe</rdfs:comment>
        <rdfs:comment xml:lang="en">Width 3 of the cap</rdfs:comment>
        <rdfs:label xml:lang="de">Kappe Breite 3</rdfs:label>
        <rdfs:label xml:lang="en">cap width 3</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#CAPxxXXb04 -->

