                                                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/bedro#wp3"/>
                                                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/bedro#s3"/>
                                                                                                                                    </rdf:Description>
