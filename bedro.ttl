@prefix bedro: <https://w3id.org/bedro#> .
@prefix bcore: <https://w3id.org/bcore#> .
@prefix bcorecomp: <https://w3id.org/bcore/comp#> .
@prefix bcoreinfra: <https://w3id.org/bcore/infra#> .
@prefix bcoremat: <https://w3id.org/bcore/mat#> .
@prefix bcorezones: <https://w3id.org/bcore/zones#> .
@prefix brot: <https://w3id.org/brot#> .
@prefix brcomp: <https://w3id.org/brcomp#> .
@prefix reloc: <https://w3id.org/reloc#> .
@prefix bot: <https://w3id.org/bot#> .
@prefix infraspatialot: <https://dtc-ontology.cms.ed.tum.de/infraspatialot#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/bedro#> .

<https://w3id.org/bedro> rdf:type owl:Ontology ;
                          owl:imports <https://w3id.org/bcore> ,
                                      <https://w3id.org/bcore/comp> ,
                                      <https://w3id.org/bcore/infra> ,
                                      <https://w3id.org/bcore/mat> ,
                                      <https://w3id.org/bcore/zones> ;
                          <http://purl.org/dc/elements/1.1/abstract> "Diese Ontologie dient der strukturierten Implementierung von Entwurfsregeln für Brückenbauteile für die frühen Phasen des Brückenentwurfs."@de ,
                                                                     "This ontology is structuring bridge desing rules for the dimensioning of bridge components in the early phases of bridge design."@en ;
                          <http://purl.org/dc/elements/1.1/title> "Ontologie für die Strukturierung von Brückenentwurfsregeln"@de ,
                                                                  "Ontology for structuring design rules for bridge components"@en ;
                          <http://purl.org/dc/terms/created> "2025-08-01"^^xsd:date ;
                          <http://purl.org/dc/terms/creator> "Tim Noack" ;
                          <http://purl.org/dc/terms/description> "Ontologie für die Implementierung von deutschen Brückenentwurfsregeln."@de ,
                                                                 "Ontology for the implementation of German design rules for bridges and bridge components."@en ;
                          <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/deed.en" ;
                          <http://purl.org/dc/terms/modified> "2026-08-07"^^xsd:date ;
                          <http://purl.org/ontology/bibo/status> "Ontology Specification Draft"@en ;
                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "bedro" ;
                          rdfs:label "Bridge Element Design Rule Ontology" ;
                          owl:versionInfo "0.1.5" ;
                          <https://schema.org/codeRepository> "https://github.com/NoackTim/BEDRO" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/abstract
<http://purl.org/dc/elements/1.1/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/ontology/bibo/status
<http://purl.org/ontology/bibo/status> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://schema.org/image
<http://schema.org/image> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionIRI
owl:versionIRI rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/image
<http://xmlns.com/foaf/0.1/image> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/logo
<http://xmlns.com/foaf/0.1/logo> rdf:type owl:AnnotationProperty .


###  https://schema.org/codeRepository
<https://schema.org/codeRepository> rdf:type owl:AnnotationProperty .


###  https://schema.org/image
<https://schema.org/image> rdf:type owl:AnnotationProperty .


###  https://schema.org/unitText
<https://schema.org/unitText> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/bcore#bridgesRoute
<https://w3id.org/bcore#bridgesRoute> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/brot#Bridge> ;
                                      rdfs:range <https://w3id.org/bcore#InfrastructureRoute> ;
                                      rdfs:comment "Brücke überquert Trasse"@de ,
                                                   "bridge bridges route"@en ;
                                      rdfs:label "bridges route"@en ,
                                                 "überquert Trasse"@de .


###  https://w3id.org/bcore#bridgesZone
<https://w3id.org/bcore#bridgesZone> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/brot#Bridge> ;
                                     rdfs:range <https://w3id.org/bot#Zone> ;
                                     rdfs:comment "Brücke überquert Zone"@de ,
                                                  "bridge bridges zone"@en ;
                                     rdfs:label "bridges zone"@en ,
                                                "überquert Zone"@de .


###  https://w3id.org/bcore#carriesRoute
<https://w3id.org/bcore#carriesRoute> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <https://w3id.org/bcore#traversesBridge> ;
                                      rdfs:domain <https://w3id.org/brot#Bridge> ;
                                      rdfs:range <https://w3id.org/bcore#InfrastructureRoute> ;
                                      rdfs:comment "Brücke überführt Trasse"@de ,
                                                   "bridge carries route"@en ;
                                      rdfs:label "carries route"@en ,
                                                 "überführt Trasse"@de .


###  https://w3id.org/bcore#crossesRoute
<https://w3id.org/bcore#crossesRoute> rdf:type owl:ObjectProperty ,
                                               owl:SymmetricProperty ;
                                      rdfs:domain <https://w3id.org/bcore#InfrastructureRoute> ;
                                      rdfs:range <https://w3id.org/bcore#InfrastructureRoute> ;
                                      rdfs:comment "Trasse kreuzt Trasse im Lageplan (ohne Beachtung der Altitude)"@de ,
                                                   "route crosses route on the site plan (without regard of the altitude)"@en ;
                                      rdfs:label "crosses route"@en ,
                                                 "kreuzt Trasse"@de .


###  https://w3id.org/bcore#crossesZone
<https://w3id.org/bcore#crossesZone> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/bcore#InfrastructureRoute> ;
                                     rdfs:range <https://w3id.org/bot#Zone> ;
                                     rdfs:comment "Trasse durchquert Zone"@de ,
                                                  "route crosses zone"@en ;
                                     rdfs:label "crosses zone"@en ,
                                                "durchquert Zone"@de .


###  https://w3id.org/bcore#describes
<https://w3id.org/bcore#describes> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/bcore#MediaFile> ;
                                   rdfs:range [ rdf:type owl:Class ;
                                                owl:unionOf ( <https://w3id.org/brot#Bridge>
                                                              <https://w3id.org/brot#Component>
                                                            )
                                              ] ;
                                   rdfs:comment "Mediendatei beschreibt (stellt dar, zeigt, veranschaulicht) eine Brücke"@de ,
                                                "media file describes (represents, depicts, illustrates) a bridge"@en ;
                                   rdfs:label "beschreibt"@de ,
                                              "describes"@en .


###  https://w3id.org/bcore#endsAt
<https://w3id.org/bcore#endsAt> rdf:type owl:ObjectProperty ;
                                rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation> ;
                                rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
                                owl:propertyDisjointWith <https://w3id.org/bcore#startsAt> ;
                                rdfs:comment "Endpunkt der Linienlokalisierung"@de ,
                                             "end point of the line localisation"@en ;
                                rdfs:label "endet an"@de ,
                                           "ends at"@en .


###  https://w3id.org/bcore#hasLocationAt
<https://w3id.org/bcore#hasLocationAt> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                                       rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
                                       rdfs:comment "Punkt der Lokalisierung (Ort)"@de ,
                                                    "point of the line localisation (location)"@en ;
                                       rdfs:label "has location at"@en ,
                                                  "ist lokalisiert an"@de ;
                                       rdfs:seeAlso "https://dtc-ontology.cms.ed.tum.de/infraspatialot#isisLocatedAt" .


###  https://w3id.org/bcore#hasPartialStructure
<https://w3id.org/bcore#hasPartialStructure> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <https://w3id.org/bcore#isPartialStructureOf> ;
                                             rdfs:domain <https://w3id.org/brot#Bridge> ;
                                             rdfs:range <https://w3id.org/brot#Bridge> ;
                                             rdfs:comment "Brücke besitzt Brückenzug"@de ,
                                                          "bridge contains partial structure (bridge section)"@en ;
                                             rdfs:label "contains partial structure"@en ,
                                                        "enthält Brückenzug"@de .


###  https://w3id.org/bcore#includesLocalisation
<https://w3id.org/bcore#includesLocalisation> rdf:type owl:ObjectProperty ;
                                              owl:inverseOf <https://w3id.org/bcore#isPartOfRoute> ;
                                              rdfs:domain <https://w3id.org/bcore#InfrastructureRoute> ;
                                              rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                                              rdfs:comment "Trasse enthält Lokalisation (Trassenpunkt)"@de ,
                                                           "route contains localisation (route point)"@en ;
                                              rdfs:label "enthält Lokalisation"@de ,
                                                         "includes localisation"@en .


###  https://w3id.org/bcore#isLocatedAt
<https://w3id.org/bcore#isLocatedAt> rdf:type owl:ObjectProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain <https://w3id.org/bot#Zone> ;
                                     rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                                     rdfs:comment "Zone befindet sich an Lokalisierung (Ort)"@de ,
                                                  "zone is located at localisation (location)"@en ;
                                     rdfs:label "befindet sich an"@de ,
                                                "is located at"@en .


###  https://w3id.org/bcore#isLocatedInZone
<https://w3id.org/bcore#isLocatedInZone> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
                                         rdfs:range <https://w3id.org/bot#Zone> ;
                                         rdfs:comment "Lokalisierung (Ort) befindet sich in Zone"@de ,
                                                      "localisation (location) is located in zone"@en ;
                                         rdfs:label "befindet sich in Zone"@de ,
                                                    "is located in zone"@en .


###  https://w3id.org/bcore#isMadeOfMaterial
<https://w3id.org/bcore#isMadeOfMaterial> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/brot#Component> ;
                                          rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
                                          rdfs:comment "Bauteil besteht aus Material"@de ,
                                                       "component consists of material"@en ;
                                          rdfs:label "besteht aus Material"@de ,
                                                     "is made of material"@en .


###  https://w3id.org/bcore#isPartOfComponent
<https://w3id.org/bcore#isPartOfComponent> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf <https://w3id.org/brot#aggregates> ;
                                           rdf:type owl:TransitiveProperty ;
                                           rdfs:domain <https://w3id.org/brot#Component> ;
                                           rdfs:range <https://w3id.org/brot#Component> ;
                                           rdfs:comment "Brückenauteil ist Teil eines anderen Bauteils"@de ,
                                                        "bridge element is part of another element"@en ;
                                           rdfs:label "is part of component"@en ,
                                                      "ist Teil von Bauteil"@de .


###  https://w3id.org/bcore#isPartOfRoute
<https://w3id.org/bcore#isPartOfRoute> rdf:type owl:ObjectProperty ,
                                                owl:FunctionalProperty ;
                                       rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                                       rdfs:range <https://w3id.org/bcore#InfrastructureRoute> ;
                                       rdfs:comment "Trassenpunkt ist Teil einer Trasse"@de ,
                                                    "localisation (route point) is part of a route"@en ;
                                       rdfs:label "is part of route"@en ,
                                                  "ist Teil von Trasse"@de .


###  https://w3id.org/bcore#isPartOfZone
<https://w3id.org/bcore#isPartOfZone> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <https://w3id.org/brot#containsComponent> ;
                                      rdf:type owl:FunctionalProperty ;
                                      rdfs:domain <https://w3id.org/brot#Component> ;
                                      rdfs:range <https://w3id.org/brot#SpatialZone> ;
                                      rdfs:comment "Bauteil ist Teil genau einer Zone (z.B. Brücke)"@de ,
                                                   "component is part of exactly one zone (e.g., bridge)"@en ;
                                      rdfs:label "is part of zone"@en ,
                                                 "ist Teil einer Zone"@de .


###  https://w3id.org/bcore#isPartialStructureOf
<https://w3id.org/bcore#isPartialStructureOf> rdf:type owl:ObjectProperty ,
                                                       owl:FunctionalProperty ;
                                              rdfs:domain <https://w3id.org/brot#Bridge> ;
                                              rdfs:range <https://w3id.org/brot#Bridge> ;
                                              rdfs:comment "Brückenzug ist Teil genau einer Brücke"@de ,
                                                           "bridge section is part of exactly one bridge"@en ;
                                              rdfs:label "is partial structure of"@en ,
                                                         "ist Brückenzug von"@de .


###  https://w3id.org/bcore#liesWithin
<https://w3id.org/bcore#liesWithin> rdf:type owl:ObjectProperty ;
                                    owl:inverseOf <https://w3id.org/bot#containsZone> ;
                                    rdf:type owl:TransitiveProperty ;
                                    rdfs:domain <https://w3id.org/bot#Zone> ;
                                    rdfs:range <https://w3id.org/bot#Zone> ;
                                    rdfs:comment "Zone wird vollständig von anderer Zone umschlossen"@de ,
                                                 "zone is fully enclosed by another zone"@en ;
                                    rdfs:label "liegt in"@de ,
                                               "lies within"@en .


###  https://w3id.org/bcore#startsAt
<https://w3id.org/bcore#startsAt> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation> ;
                                  rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
                                  rdfs:comment "Startpunkt der Linienlokalisierung"@de ,
                                               "starting point of the line localisation"@en ;
                                  rdfs:label "beginnt an"@de ,
                                             "starts at"@en .


###  https://w3id.org/bcore#traversesBridge
<https://w3id.org/bcore#traversesBridge> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/bcore#InfrastructureRoute> ;
                                         rdfs:range <https://w3id.org/brot#Bridge> ;
                                         rdfs:comment "Trasse überquert/führt über Brücke"@de ,
                                                      "route crosses/goes over bridge"@en ;
                                         rdfs:label "traverses bridge"@en ,
                                                    "überquert Brücke"@de .


###  https://w3id.org/bcore/comp#beginsAtLocation
<https://w3id.org/bcore/comp#beginsAtLocation> rdf:type owl:ObjectProperty ,
                                                        owl:FunctionalProperty ;
                                               rdfs:domain <https://w3id.org/bcore/comp#Span> ;
                                               rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                                               owl:propertyDisjointWith <https://w3id.org/bcore/comp#endsAtLocation> ;
                                               rdfs:comment "Spannweite beginnt an einer Lokalisation (Punkt)"@de ,
                                                            "span begins at localision (location point)"@en ;
                                               rdfs:label "begins at location"@en .


###  https://w3id.org/bcore/comp#beginsAtSupport
<https://w3id.org/bcore/comp#beginsAtSupport> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/bcore/comp#Span> ;
                                              rdfs:range <https://w3id.org/brcomp#SubStructureComponent> ;
                                              owl:propertyDisjointWith <https://w3id.org/bcore/comp#endsAtSupport> ;
                                              rdfs:comment "Spannweite beginnt an einem Bauteil des Brückenunterbaus"@de ,
                                                           "span begins at a component of the bridge substructure"@en ;
                                              rdfs:label "begins at support"@en .


###  https://w3id.org/bcore/comp#endsAtLocation
<https://w3id.org/bcore/comp#endsAtLocation> rdf:type owl:ObjectProperty ,
                                                      owl:FunctionalProperty ;
                                             rdfs:domain <https://w3id.org/bcore/comp#Span> ;
                                             rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                                             rdfs:comment "Spannweite endet an einer Lokalisation (Punkt)"@de ,
                                                          "span ends at localision (location point)"@en ;
                                             rdfs:label "ends at location"@en .


###  https://w3id.org/bcore/comp#endsAtSupport
<https://w3id.org/bcore/comp#endsAtSupport> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/bcore/comp#Span> ;
                                            rdfs:range <https://w3id.org/brcomp#SubStructureComponent> ;
                                            rdfs:comment "Spannweite endet an einem Bauteil des Brückenunterbaus"@de ,
                                                         "span ends at a component of the bridge substructure"@en ;
                                            rdfs:label "ends at support"@en .


###  https://w3id.org/bcore/comp#followsSpan
<https://w3id.org/bcore/comp#followsSpan> rdf:type owl:ObjectProperty ,
                                                   owl:TransitiveProperty ;
                                          rdfs:domain <https://w3id.org/bcore/comp#Span> ;
                                          rdfs:range <https://w3id.org/bcore/comp#Span> ;
                                          rdfs:comment "Spannweite liegt hinter einer anderen Spannweite (wird genutzt, um Teilspannweiten darzustellen, z. B. bei Einzelspannweiten eines Durchlaufträgers oder Hängerabstände einer Schrägkabelbrücke)"@de ,
                                                       "span is located behind another span (used to represent partial spans, e.g., individual spans of a continuous girder or suspension spans of a cable-stayed bridge)"@en ;
                                          rdfs:label "follows span"@en .


###  https://w3id.org/bcore/comp#hasMainSpan
<https://w3id.org/bcore/comp#hasMainSpan> rdf:type owl:ObjectProperty ,
                                                   owl:FunctionalProperty ;
                                          rdfs:domain <https://w3id.org/brot#Bridge> ;
                                          rdfs:range <https://w3id.org/bcore/comp#Span> ;
                                          rdfs:comment "Brücke hat eine Hauptspannweite"@de ,
                                                       "bridge has main span"@en ;
                                          rdfs:label "has main span"@en .


###  https://w3id.org/bcore/comp#hasSpan
<https://w3id.org/bcore/comp#hasSpan> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/brcomp#SuperStructureComponent> ;
                                      rdfs:range <https://w3id.org/bcore/comp#Span> ;
                                      rdfs:comment "Bauteil hat eine Spannweite"@de ,
                                                   "component has span"@en ;
                                      rdfs:label "has span"@en .


###  https://w3id.org/bcore/comp#isSpanOf
<https://w3id.org/bcore/comp#isSpanOf> rdf:type owl:ObjectProperty ,
                                                owl:FunctionalProperty ;
                                       rdfs:domain <https://w3id.org/bcore/comp#Span> ;
                                       rdfs:range <https://w3id.org/brot#Bridge> ;
                                       rdfs:comment "ist Feld von genau einer Brücke"@de ,
                                                    "the span belongs to just one bridge"@en ;
                                       rdfs:label "is span of"@en .


###  https://w3id.org/bcore/mat#isCompositeOf
<https://w3id.org/bcore/mat#isCompositeOf> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/bcore/mat#CompositeMaterial> ;
                                           rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
                                           rdfs:comment "Verbundmaterial ist Verbund aus anderem Material"@de ,
                                                        "composite material is a composite of another material"@en ;
                                           rdfs:label "is composite of"@en ,
                                                      "ist Verbund aus"@de .


###  https://w3id.org/bedro#equalsRoutePoint
:equalsRoutePoint rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdf:type owl:SymmetricProperty ;
                  rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                  rdfs:comment "Punkt gleicht anderem Punkt in X- und Y-Koordinaten, nicht unbeding in Z-Koordinaten"@de ,
                               "route point equals other point in X- and Y-coordinates but not necessarily in Z-coordinate"@en ;
                  rdfs:label "equals route point"@en ,
                             "ist äquivalent zu Trassenpunkt"@de .


###  https://w3id.org/bedro#runsToTheLeftOf
:runsToTheLeftOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf :runsToTheRightOf ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain <https://w3id.org/bcore#InfrastructureRoute> ;
                 rdfs:range <https://w3id.org/bcore#InfrastructureRoute> ;
                 rdfs:comment "Die Infrastrukturtrasse verläuft parallel zu einer anderen Trasse, in Trassierungsrichtung links davon."@de ,
                              "The infrastructure route runs parallely to another route, in direction of the route left of it."@en ;
                 rdfs:label "runs to the left of"@en ,
                            "verläuft links von"@de .


###  https://w3id.org/bedro#runsToTheRightOf
:runsToTheRightOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdf:type owl:TransitiveProperty ;
                  rdfs:domain <https://w3id.org/bcore#InfrastructureRoute> ;
                  rdfs:range <https://w3id.org/bcore#InfrastructureRoute> ;
                  rdfs:comment "Die Infrastrukturtrasse verläuft parallel zu einer anderen Trasse, in Trassierungsrichtung rechts davon."@de ,
                               "The infrastructure route runs parallely to another route, in direction of the route right of it."@en ;
                  rdfs:label "runs to the right of"@en ,
                             "verläuft rechts von"@de .


###  https://w3id.org/bot#containsZone
<https://w3id.org/bot#containsZone> rdf:type owl:ObjectProperty ,
                                             owl:TransitiveProperty ;
                                    rdfs:domain <https://w3id.org/bot#Zone> ;
                                    rdfs:range <https://w3id.org/bot#Zone> ;
                                    rdfs:comment "Zone enthält Zone"@de ,
                                                 "zone contains zone"@en ;
