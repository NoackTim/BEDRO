<https://w3id.org/bcore#LocalX> rdf:type owl:DatatypeProperty .


###  https://w3id.org/bcore#LocalY
<https://w3id.org/bcore#LocalY> rdf:type owl:DatatypeProperty .


###  https://w3id.org/bcore#RoadRouteClass
<https://w3id.org/bcore#RoadRouteClass> rdf:type owl:DatatypeProperty .


###  https://w3id.org/bcore#SpanLength
<https://w3id.org/bcore#SpanLength> rdf:type owl:DatatypeProperty .


###  https://w3id.org/bedro#BridgeWidth
:BridgeWidth rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain <https://w3id.org/brot#Bridge> ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Brückenbreite"@de ,
                          "bridge width/ bridge broadth"@en ,
                          "[m]" .


###  https://w3id.org/bedro#CAPxxCUe00
:CAPxxCUe00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Existenz des Schrammbords der Kappe"@de ;
            rdfs:label "Existence of the curb at the cap"@en .


###  https://w3id.org/bedro#CAPxxXXb01
:CAPxxXXb01 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Breite 1 der Kappe"@de ,
                         "[m]" ;
            rdfs:label "Width 1 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXb02
:CAPxxXXb02 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Breite 2 der Kappe"@de ,
                         "[m]" ;
            rdfs:label "Width 2 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXb03
:CAPxxXXb03 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Breite 3 der Kappe"@de ,
                         "[m]" ;
            rdfs:label "Width 3 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXg00
:CAPxxXXg00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:string ;
            rdfs:comment "Typologie (Art) der Kappe"@de ;
            rdfs:label "Typology of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXh01
:CAPxxXXh01 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Höhe 1 der Kappe"@de ,
                         "[m]" ;
            rdfs:label "Height 1 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXh02
:CAPxxXXh02 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Höhe 2 der Kappe"@de ,
                         "[m]" ;
            rdfs:label "Height 2 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXh03
:CAPxxXXh03 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Höhe 3 der Kappe"@de ,
                         "[m]" ;
            rdfs:label "Height 3 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXn01
:CAPxxXXn01 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Neigung 1 der Kappe"@de ,
                         "[-]" ;
            rdfs:label "Inclination 1 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXn02
:CAPxxXXn02 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Neigung 2 der Kappe"@de ,
                         "[-]" ;
            rdfs:label "Inclination 2 of the cap"@en .


###  https://w3id.org/bedro#CAPxxXXn03
:CAPxxXXn03 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Cap> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Neigung 3 der Kappe"@de ,
                         "[-]" ;
            rdfs:label "Inclination 3 of the cap"@en .


###  https://w3id.org/bedro#PAVxxXXb00
:PAVxxXXb00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Pavement> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Breite des Fahrbahnbelags"@de ,
                         "Width of the pavement"@en ,
                         "[m]" .


###  https://w3id.org/bedro#PAVxxXXh00
:PAVxxXXh00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Pavement> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Height of the pavement"@en ,
                         "Höhe des Fahrbahnbelags"@de ,
                         "[m]" .


###  https://w3id.org/bedro#PAVxxXXn00
:PAVxxXXn00 rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#Pavement> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Inclination of the pavement"@en ,
                         "Neigung des Fahrbahnbelags"@de ,
                         "[-]" .


###  https://w3id.org/bedro#SpanRadius
:SpanRadius rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/bcore/comp#Span> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "[m]" .


###  https://w3id.org/bedro#SupportNotPossible
:SupportNotPossible rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Lässt sich hier keine Stütze errichten?"@de .


###  https://w3id.org/bedro#SupportNotRecommended
:SupportNotRecommended rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Ist hier die Errichtung einer Stütze nicht empfohlen?"@de .


###  https://w3id.org/bedro#TRBxxXXb00
:TRBxxXXb00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brcomp#TrafficBarrier> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Breite der Schutzeinrichtung"@de ,
                         "Width of the traffic barrier"@en ,
                         "[m]" .


###  https://w3id.org/bedro#XXXxxXXf00
:XXXxxXXf00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:string ;
            rdfs:comment "Colour of the component"@en ,
                         "Declaration in words (e.g. \"blue\" or \"dark green\") or Hex-Code (\"#0000ff\" or \"#008800\")"@en ,
                         "Farbe des Bauteils"@de .


###  https://w3id.org/bedro#XXXxxXXp00
:XXXxxXXp00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:integer ;
            rdfs:comment "Position des Bauteils senkrecht zur Trasse (Index)"@de ,
                         "Position of the component perpendicular to the alignment (index)"@en .


###  https://w3id.org/bedro#XXXxxXXq00
:XXXxxXXq00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Normal distance of the component perpendicular to alignment (positive to the right)"@en ,
                         "Normaldistanz des Bauteils zur Trasse (positiv nach rechts)"@de ,
                         "[m]" .


###  https://w3id.org/bedro#XXXxxXXs00
:XXXxxXXs00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Kilometrierung des Bauteilbeginns (Stationierung)"@de ,
                         "Station of the component beginning (kilometer of route)"@en ,
                         "[m]" .


###  https://w3id.org/bedro#XXXxxXXz00
:XXXxxXXz00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Altitude of the component"@en ,
                         "Höhe des Bauteils über NN"@de ,
                         "[m AMSL]" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bcore#InfrastructureRoute
<https://w3id.org/bcore#InfrastructureRoute> rdf:type owl:Class .


###  https://w3id.org/bedro#Asphalt
:Asphalt rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:comment "Asphalt"@de ,
                      "asphalt"@en .


###  https://w3id.org/bedro#AsphaltConcrete
:AsphaltConcrete rdf:type owl:Class ;
                 rdfs:subClassOf :Asphalt ;
                 rdfs:comment "Betonasphalt"@de ,
                              "asphalt concrete"@en .


###  https://w3id.org/bedro#Bitumen
:Bitumen rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:comment "Bitumen"@de ,
                      "bitumen"@en .


###  https://w3id.org/bedro#Elastomer
:Elastomer rdf:type owl:Class ;
           rdfs:subClassOf :Plastic ;
           owl:disjointWith :PTFE ;
           rdfs:comment "Elastomer"@de ,
                        "elastomer"@en .


###  https://w3id.org/bedro#MasticAsphalt
:MasticAsphalt rdf:type owl:Class ;
               rdfs:subClassOf :Asphalt ;
               rdfs:comment "Gussasphalt"@de ,
                            "mastic asphalt"@en .


###  https://w3id.org/bedro#PTFE
:PTFE rdf:type owl:Class ;
      rdfs:subClassOf :Plastic ;
      rdfs:comment "Polytetrafluorethylen (PTFE)/ Teflon"@de ,
                   "polytetrafluoroethylene (PTFE)"@en .


###  https://w3id.org/bedro#PavementCover
:PavementCover rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/brcomp#Pavement> ;
               rdfs:comment "Deckschicht"@de ,
                            "pavement cover"@en .


###  https://w3id.org/bedro#PavementImperviousBlanket
:PavementImperviousBlanket rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/brcomp#Pavement> ;
                           rdfs:comment "Dichtungsschicht"@de ,
                                        "pavement impervious blanket/ confining layer/ impermeable layer/ tight blanket/ waterproof blanket"@en .


###  https://w3id.org/bedro#PavementProtectionLayer
:PavementProtectionLayer rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/brcomp#Pavement> ;
                         rdfs:comment "Schutzschicht"@de ,
                                      "pavement protection layer/ protective layer/ wear resisting layer"@en .


###  https://w3id.org/bedro#Plastic
:Plastic rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:comment "Kunststoff/ Plastik"@de ,
                      "plastic/ synthetic material"@en .


###  https://w3id.org/bedro#Slab
:Slab rdf:type owl:Class ;
      rdfs:subClassOf <https://w3id.org/brcomp#GirderMainGirder> .


###  https://w3id.org/bedro#SoilMaterial
:SoilMaterial rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
              rdfs:comment "Bodenmaterial"@de ,
                           "soil material/ ground material"@en .


###  https://w3id.org/bedro#StoneMasticAsphalt
:StoneMasticAsphalt rdf:type owl:Class ;
                    rdfs:subClassOf :Asphalt ;
                    rdfs:comment "Steinmastixasphalt"@de ,
                                 "stone mastic asphalt"@en .


###  https://w3id.org/bmat#BuildingMaterial
<https://w3id.org/bmat#BuildingMaterial> rdf:type owl:Class .


###  https://w3id.org/bot#Building
<https://w3id.org/bot#Building> rdf:type owl:Class .


###  https://w3id.org/bot#Zone
<https://w3id.org/bot#Zone> rdf:type owl:Class .


###  https://w3id.org/brcomp#Cap
<https://w3id.org/brcomp#Cap> rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( <https://w3id.org/brcomp#Cap>
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :CAPxxXXn02 ;
                                                                           owl:hasValue 0.075
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                              rdfs:comment "Kappe/ Randbalken"@de ;
                              rdfs:label "cap/ bridge cap/ edge beam/ rim beam"@en .


###  https://w3id.org/brcomp#Girder
<https://w3id.org/brcomp#Girder> rdf:type owl:Class .


###  https://w3id.org/brcomp#GirderDeck
<https://w3id.org/brcomp#GirderDeck> rdf:type owl:Class .


###  https://w3id.org/brcomp#GirderMainGirder
<https://w3id.org/brcomp#GirderMainGirder> rdf:type owl:Class .


###  https://w3id.org/brcomp#NoiseBarrier
<https://w3id.org/brcomp#NoiseBarrier> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                       rdfs:comment "Lärmschutzwand (LSW)/ Schallschutzwand"@de ,
                                                    "noise barrier/ noise protection wall/ soundproof wall" .


###  https://w3id.org/brcomp#Pavement
<https://w3id.org/brcomp#Pavement> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                   rdfs:comment "Fahrbahn(-belag)"@de ,
                                                "pavement/ driving surface/ decking"@en .


###  https://w3id.org/brcomp#Railing
<https://w3id.org/brcomp#Railing> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                  rdfs:comment "Geländer/ Fußgängerrückhaltesystem/ Brüstung"@de ,
                                               "railing/ handrail/ guard railing/ balustrade"@en .


###  https://w3id.org/brcomp#TrafficBarrier
<https://w3id.org/brcomp#TrafficBarrier> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                         rdfs:comment "Fahrzeugrückhaltesystem/ Schutzeinrichtung/ Leitplanke"@de ,
                                                      "traffic barrier/ guard railing/ crash barrier/ safety fence/ side rail"@en .


###  https://w3id.org/brot#Bridge
<https://w3id.org/brot#Bridge> rdf:type owl:Class .


###  https://w3id.org/brot#Component
<https://w3id.org/brot#Component> rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AsphaltConcrete
                :MasticAsphalt
                :StoneMasticAsphalt
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PavementCover
                :PavementImperviousBlanket
                :PavementProtectionLayer
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/brcomp#Cap>
                <https://w3id.org/brcomp#NoiseBarrier>
                <https://w3id.org/brcomp#Pavement>
                <https://w3id.org/brcomp#Railing>
                <https://w3id.org/brcomp#TrafficBarrier>
              )
] .


