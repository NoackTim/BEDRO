                         "Width of the traffic barrier"@en ;
            rdfs:label "Fahrzeugrückhaltesystem Breite"@de ,
                       "traffic barrier width"@en ;
            <https://schema.org/unitText> "m" .


###  https://w3id.org/bedro#XXXxxXXf00
:XXXxxXXf00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :BridgeOntologyParameter ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:string ;
            rdfs:comment "Colour of the component"@en ,
                         "Farbe des Bauteils"@de ;
            rdfs:label "Bauteilfarbe"@de ,
                       "component color"@en ;
            <https://schema.org/unitText> "Declaration in words (e.g. \"blue\" or \"dark green\") or Hex-Code (\"#0000ff\" or \"#008800\")" .


###  https://w3id.org/bedro#XXXxxXXp00
:XXXxxXXp00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :BridgeOntologyParameter ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:integer ;
            rdfs:comment "Position des Bauteils horizontal senkrecht zur Trasse (Index)"@de ,
                         "Position of the component horizontally perpendicular to the alignment (index)"@en ;
            rdfs:label "Bauteil transversale Position"@de ,
                       "component transversal position"@en .


###  https://w3id.org/bedro#XXXxxXXq00
:XXXxxXXq00 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :BridgeOntologyParameter ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Normal distance of the component cross section's reference point transversal to alignment (positive to the right)/ Offset of the bridge's axis"@en ,
                         "Normaldistanz des Referenzpunkts des Bauteilquerschnitts zur Trasse (positiv nach rechts)"@de ;
            rdfs:label "Bauteil transversaler Versatz"@de ,
                       "component axis offset"@en ;
            <https://schema.org/unitText> "m" .


###  https://w3id.org/bedro#XXXxxXXs01
:XXXxxXXs01 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :BridgeOntologyParameter ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Kilometrierung des Bauteilbeginns (Stationierung)"@de ,
                         "Station of the component beginning (kilometer of route)"@en ;
            rdfs:label "Bauteilstationierung Start"@de ,
                       "component station start"@en ;
            <https://schema.org/unitText> "m" .


###  https://w3id.org/bedro#XXXxxXXs02
:XXXxxXXs02 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :BridgeOntologyParameter ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Kilometrierung des Bauteilendes (Stationierung)"@de ,
                         "Station of the component ending (kilometer of route)"@en ;
            rdfs:label "Bauteilstationierung Ende"@de ,
                       "component station end"@en ;
            <https://schema.org/unitText> "m" .


###  https://w3id.org/bedro#XXXxxXXz01
:XXXxxXXz01 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :BridgeOntologyParameter ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Altitude of the component beginning"@en ,
                         "Höhe des Bauteilanfangs über NN"@de ;
            rdfs:label "Bauteilkote Start"@de ,
                       "component altitude start"@en ;
            <https://schema.org/unitText> "m AMSL" .


###  https://w3id.org/bedro#XXXxxXXz02
:XXXxxXXz02 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :BridgeOntologyParameter ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Altitude of the component ending"@en ,
                         "Höhe des Bauteilendes über NN"@de ;
            rdfs:label "Bauteilkote Ende"@de ,
                       "component altitude end"@en ;
            <https://schema.org/unitText> "m AMSL" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bcore#InfrastructureRoute
<https://w3id.org/bcore#InfrastructureRoute> rdf:type owl:Class .


###  https://w3id.org/bcore/comp#EquipmentComponent
<https://w3id.org/bcore/comp#EquipmentComponent> rdf:type owl:Class .


###  https://w3id.org/bedro#Asphalt
:Asphalt rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:comment "Material Asphalt"@de ,
                      "asphalt/ tarmac"@en ;
         rdfs:label "Asphalt"@de ,
                    "asphalt"@en .


###  https://w3id.org/bedro#AsphaltConcrete
:AsphaltConcrete rdf:type owl:Class ;
                 rdfs:subClassOf :Asphalt ;
                 rdfs:comment "Asphaltbeton-Material"@de ,
                              "asphalt concrete/ bitumen concrete"@en ;
                 rdfs:label "Asphaltbeton"@de ,
                            "asphalt concrete"@en .


###  https://w3id.org/bedro#Bitumen
:Bitumen rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:comment "Bitumen/ Erdharz/ Erdpech"@de ,
                      "material bitumen"@en ;
         rdfs:label "Bitumen"@de ,
                    "bitumen"@en .


###  https://w3id.org/bedro#Elastomer
:Elastomer rdf:type owl:Class ;
           rdfs:subClassOf :Plastic ;
           owl:disjointWith :PTFE ;
           rdfs:comment "Elastomer/ Elastoplast"@de ,
                        "material elastomer"@en ;
           rdfs:label "Elastomer"@de ,
                      "elastomer"@en .


###  https://w3id.org/bedro#MasticAsphalt
:MasticAsphalt rdf:type owl:Class ;
               rdfs:subClassOf :Asphalt ;
               rdfs:comment "Gussasphalt/ Asphaltmastix"@de ,
                            "asphalt mastic"@en ;
               rdfs:label "Gussasphalt"@de ,
                          "mastic asphalt"@en .


###  https://w3id.org/bedro#PTFE
:PTFE rdf:type owl:Class ;
      rdfs:subClassOf :Plastic ;
      rdfs:comment "Polytetrafluorethylen (PTFE)/ Teflon"@de ,
                   "polytetrafluoroethylene (PTFE)"@en ;
      rdfs:label "PTFE"@de ,
                 "PTFE"@en .


###  https://w3id.org/bedro#PavementCover
:PavementCover rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/brcomp#Pavement> ;
               rdfs:comment "Deckschicht Fahrbahnbelag"@de ,
                            "cover layer of pavement"@en ;
               rdfs:label "Deckschicht"@de ,
                          "pavement cover"@en .


###  https://w3id.org/bedro#PavementImperviousBlanket
:PavementImperviousBlanket rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/brcomp#Pavement> ;
                           rdfs:comment "Dichtungsschicht Fahrbahnbelag"@de ,
                                        "pavement impervious blanket/ confining layer/ impermeable layer/ tight blanket/ waterproof blanket"@en ;
                           rdfs:label "Dichtungsschicht"@de ,
                                      "impervious blanket"@en .


###  https://w3id.org/bedro#PavementProtectionLayer
:PavementProtectionLayer rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/brcomp#Pavement> ;
                         rdfs:comment "Schutzschicht Fahrbahnbelag"@de ,
                                      "pavement protection layer/ protective layer/ wear resisting layer"@en ;
                         rdfs:label "Schutzschicht"@de ,
                                    "protection layer"@en .


###  https://w3id.org/bedro#Plastic
:Plastic rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:comment "Kunststoff/ Plastik"@de ,
                      "plastic/ synthetic material"@en ;
         rdfs:label "Kunststoff"@de ,
                    "plastic"@en .


###  https://w3id.org/bedro#SoilMaterial
:SoilMaterial rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
              rdfs:comment "Bodenmaterial/ Erdmaterial"@de ,
                           "soil material/ ground material"@en ;
              rdfs:label "Bodenmaterial"@de ,
                         "soil material"@en .


###  https://w3id.org/bedro#StoneMasticAsphalt
:StoneMasticAsphalt rdf:type owl:Class ;
                    rdfs:subClassOf :Asphalt ;
                    rdfs:comment "Steinmastixasphalt-Material"@de ,
                                 "material stone mastic asphalt"@en ;
                    rdfs:label "Steinmastixasphalt"@de ,
                               "stone mastic asphalt"@en .


###  https://w3id.org/bmat#BuildingMaterial
<https://w3id.org/bmat#BuildingMaterial> rdf:type owl:Class .


###  https://w3id.org/bot#Building
<https://w3id.org/bot#Building> rdf:type owl:Class .


###  https://w3id.org/bot#Zone
<https://w3id.org/bot#Zone> rdf:type owl:Class .


###  https://w3id.org/brcomp#Cap
<https://w3id.org/brcomp#Cap> rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                              rdfs:comment "Kappe/ Randbalken"@de ,
                                           "cap/ bridge cap/ edge beam/ rim beam"@en ;
                              rdfs:label "Kappe"@de ,
                                         "cap"@en .


###  https://w3id.org/brcomp#NoiseBarrier
<https://w3id.org/brcomp#NoiseBarrier> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                       rdfs:comment "Lärmschutzwand (LSW)/ Schallschutzwand"@de ,
                                                    "noise barrier/ noise protection wall/ soundproof wall" ;
                                       rdfs:label "Lärmschutzwand"@de ,
                                                  "noise barrier"@en .


###  https://w3id.org/brcomp#Pavement
<https://w3id.org/brcomp#Pavement> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                   rdfs:comment "Fahrbahn(-belag)"@de ,
                                                "pavement/ driving surface/ decking"@en ;
                                   rdfs:label "Fahrbahnbelag"@de ,
                                              "pavement"@en .


###  https://w3id.org/brcomp#Railing
<https://w3id.org/brcomp#Railing> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                  rdfs:comment "Geländer/ Fußgängerrückhaltesystem/ Brüstung"@de ,
                                               "railing/ handrail/ guard railing/ balustrade"@en ;
                                  rdfs:label "Geländer"@de ,
                                             "railing"@en .


###  https://w3id.org/brcomp#TrafficBarrier
<https://w3id.org/brcomp#TrafficBarrier> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/bcore/comp#EquipmentComponent> ;
                                         rdfs:comment "Fahrzeugrückhaltesystem/ Schutzeinrichtung/ Leitplanke"@de ,
                                                      "traffic barrier/ guard railing/ crash barrier/ safety fence/ side rail"@en ;
                                         rdfs:label "Fahrzeugrückhaltesystem"@de ,
                                                    "traffic barrier"@en .


###  https://w3id.org/brot#Bridge
<https://w3id.org/brot#Bridge> rdf:type owl:Class .


###  https://w3id.org/brot#Component
<https://w3id.org/brot#Component> rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AsphaltConcrete
                :MasticAsphalt
                :StoneMasticAsphalt
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PavementCover
                :PavementImperviousBlanket
                :PavementProtectionLayer
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/brcomp#Cap>
                <https://w3id.org/brcomp#NoiseBarrier>
                <https://w3id.org/brcomp#Pavement>
                <https://w3id.org/brcomp#Railing>
                <https://w3id.org/brcomp#TrafficBarrier>
              )
] .


#################################################################
#    Rules
#################################################################

:c rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:b rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:p rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:s rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:n rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:r rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:t rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "DE: Wenn Kappe und Geländer rechts auf einer Brücke liegen, ist das Geländer direkt über der Kappe positioniert.; EN: If the cap and the railing are on the right side of a bridge, the railing is positioned directly above the cap." ;
   rdfs:label "CAP99_RAI99" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :XXXxxXXp00 ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :r ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> 99
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://w3id.org/bcore#isPartOfZone> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :r ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :b
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :XXXxxXXp00 ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> 99
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://w3id.org/bcore#isPartOfZone> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :b
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/brcomp#Cap> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :c
                                                                                                 ] ;
                                                                                       rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                  rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/brcomp#Railing> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument1> :r
                                                                                                            ] ;
                                                                                                  rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                             rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/brot#Bridge> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#argument1> :b
                                                                                                                       ] ;
                                                                                                             rdf:rest rdf:nil
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://w3id.org/reloc#meetTop> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :r ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :c
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "DE: Wenn Kappe und Schutzeinrichtung links auf einer Brücke liegen, ist die Schutzeinrichtung direkt über der Kappe positioniert.; EN: If the cap and the traffic barrier are on the left side of a bridge, the traffic barrier is positioned directly above the cap." ;
   rdfs:label "CAP01_TRB01" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
