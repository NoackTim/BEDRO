                                       rdfs:domain <https://w3id.org/bcore/mat#Steel> ;
                                       rdfs:range xsd:string ;
                                       rdfs:comment "die Eigenschaft eines Werkstoffes, sich unter Zugbelastung vor einem Bruch dauerhaft plastisch zu verformen (https://de.wikipedia.org/wiki/Duktilit%C3%A4t)"@de ,
                                                    "the ability of a material to sustain significant plastic deformation before fracture when undergoing tension (https://en.wikipedia.org/wiki/Ductility)"@en ;
                                       rdfs:label "Duktilität"@de ,
                                                  "ductility"@en .


