###  https://w3id.org/bedro#BridgeOntologyParameter
:BridgeOntologyParameter rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:domain <https://w3id.org/brot#Component> ;
                         rdfs:range [ rdf:type rdfs:Datatype ;
                                      owl:unionOf ( xsd:boolean
                                                    xsd:decimal
                                                    xsd:integer
                                                    xsd:string
                                                  )
                                    ] ;
                         rdfs:comment "Parameter following the Bridge Ontology Parametercoding (BOP) convention, developed at the Institute of Concrete Structures, Technische Universität Dresden. The parameters define geometric and other attributes of bridge components. Each parameter is coded with a ten-character alphanumeric code: AAAbbCCdEE (A: component, b: transversal position, C: sub-component, d: attribute type, E: attribute number). X or 00 means global [applies for every (sub-)component/ attribute of that kind]."@en ,
                                      "Parameter, der der Bridge Ontology Parametercoding (BOP) Namenskonvention folgt, die am Institut für Massivbau, Technische Universität Dresden, entwickelt wurde. Die Parameter definieren geometrische und weitere Attribute von Brückenbauteilen. Jeder Parameter ist mit einem zehnstelligen alphanumerischen Code beschrieben: AAAbbCCdEE (A: Bauteil, b: transversale Position, C: Teilbauteil, d: Art des Attributs, E: Nummer des Attributs). X oder 00 bedeutet global [gilt für alle (Teil-)Bauteile/Attribute dieser Art]."@de ;
                         rdfs:label "Brückenontologieparameter"@de ,
                                    "bridge ontology parameter"@en .


###  https://w3id.org/bedro#BridgeWidth
:BridgeWidth rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain <https://w3id.org/brot#Bridge> ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Gesamtbreite des Regelquerschnitts der Brücke"@de ,
                          "bridge width/ bridge broadth"@en ;
             rdfs:label "Brückenbreite"@de ,
                        "bridge width"@en ;
             <https://schema.org/unitText> "m" .


