#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/bcore/comp#Abutment>
                <https://w3id.org/brcomp#Arch>
                <https://w3id.org/brcomp#Bearing>
                <https://w3id.org/brcomp#Foundation>
                <https://w3id.org/brcomp#Pier>
                <https://w3id.org/brcomp#Pile>
                <https://w3id.org/brcomp#Pylon>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/bcore/comp#BoxGirder>
                <https://w3id.org/bcore/comp#IBeam>
                <https://w3id.org/bcore/comp#PlateGirder>
                <https://w3id.org/bcore/comp#TBeam>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/bcore/infra#FootCycleRoute>
                <https://w3id.org/bcore/infra#RailwayRoute>
                <https://w3id.org/bcore/infra#RoadRoute>
                <https://w3id.org/bcore/infra#WaterWayRoute>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/bcore/mat#CompositeMaterial>
                <https://w3id.org/bcore/mat#Metal>
                <https://w3id.org/bmat#Concrete>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/bcore/mat#PrestressedConcrete>
                <https://w3id.org/bcore/mat#SteelConcreteComposite>
                <https://w3id.org/bmat#ReinforcedConcrete>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/bcore/zones#BuiltUpArea>
                <https://w3id.org/bcore/zones#Estate>
                <https://w3id.org/bcore/zones#LandscapeConservationMeasureArea>
                <https://w3id.org/bcore/zones#VegetationArea>
                <https://w3id.org/bcore/zones#WaterBody>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AsphaltConcrete
                :MasticAsphalt
                :StoneMasticAsphalt
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PavementComponent
                <https://w3id.org/brcomp#Cap>
                <https://w3id.org/brcomp#NoiseBarrier>
                <https://w3id.org/brcomp#Pavement>
                <https://w3id.org/brcomp#Railing>
                <https://w3id.org/brcomp#TrafficBarrier>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PavementCoverLayer
                :PavementProtectionLayer
                :PavementWaterproofLayer
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/brcomp#AbutmentBenching>
                <https://w3id.org/brcomp#AbutmentChamberWall>
                <https://w3id.org/brcomp#AbutmentFooting>
                <https://w3id.org/brcomp#AbutmentWingWall>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/brcomp#Arch>
                <https://w3id.org/brcomp#Girder>
                <https://w3id.org/brcomp#GirderComponent>
                <https://w3id.org/brcomp#Pylon>
                <https://w3id.org/brcomp#TensionComponent>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/brcomp#GirderCrossGirder>
                <https://w3id.org/brcomp#GirderDeck>
                <https://w3id.org/brcomp#GirderMainGirder>
              )
] .


