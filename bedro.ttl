                                                                                                                                         rdf:first "urban road" ;
                                                                                                                                         rdf:rest rdf:nil
                                                                                                                                       ]
                                                                                                                            ]
                                                                                                                 ]
                                                                                                      ]
                                                                                           ]
                                                                                ]
                                                                     ]
                                                         ] ;
                                              rdfs:comment "Klassifizierung der Straße"@de ,
                                                           """Road classification. Possible values:
- highway
- federal road
- country road
- district road
- urban road
- agricultural road
- non-public road"""@en ;
                                              rdfs:label "Straßentrasse Klasse"@de ,
                                                         "road route class"@en .


###  https://w3id.org/bcore/infra#RoadRouteNumberOfLanes
<https://w3id.org/bcore/infra#RoadRouteNumberOfLanes> rdf:type owl:DatatypeProperty ,
