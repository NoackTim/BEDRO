            rdfs:comment "Typologie (Art) der Kappe"@de ,
                         "Typology of the cap"@en ;
            rdfs:label "Kappe Typologie"@de ,
                       "cap typology"@en .


###  https://w3id.org/bedro#CAPxxXXh01
:CAPxxXXh01 rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
