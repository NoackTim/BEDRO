        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tim.noack/ontologies/BEDRO/x2">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tim.noack/ontologies/BEDRO/h01">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Ist die Maximalgeschwindigkeit der Eisenbahnstrecke größer als 200 km/h, so ist das Lichtraumprofil (ohne Überhöhung) mindestens 7.40m hoch. (RE-ING Teil 2-1 Anhang A)</rdfs:comment>
        <rdfs:label>RailwayClearanceHeight&gt;200km/h</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RailwayRoute"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#RailwayMaximumVelocity"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/v"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="https://w3id.org/BEDRO/v"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#InfrastructureRouteClearanceHeight"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.40</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Liegt die Maximalgeschwindigkeit der Eisenbahnstrecke zwischen 160 und 200 km/h, so ist das Lichtraumprofil (ohne Überhöhung) mindestens 5,90m hoch. (RE-ING Teil 2-1)</rdfs:comment>
        <rdfs:label>RailwayClearanceHeight160&lt;v&lt;=200km/h</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RailwayRoute"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#RailwayMaximumVelocity"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/v"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="https://w3id.org/BEDRO/v"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                                <swrl:arguments>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:resource="https://w3id.org/BEDRO/v"/>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">160</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </swrl:arguments>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#InfrastructureRouteClearanceHeight"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.90</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Ist die Straße ein Wirtschaftsweg, so ist das Lichtraumprofil 4,50m hoch und 5,00m breit. (RE-ING Teil 2-1)</rdfs:comment>
        <rdfs:label>RoadClearanceHeightAgriculturalRoad</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RoadRoute"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#RoadClass"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/cl"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#equal"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="https://w3id.org/BEDRO/cl"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>agricultural road</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#InfrastructureRouteClearanceHeight"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.50</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRouteWidth"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                                <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.00</swrl:argument2>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Ist die Straße eine Überlandstraße und kein Wirtschaftsweg, so ist das Lichtraumprofil 4,70m hoch. (RE-ING Teil 2-1)</rdfs:comment>
        <rdfs:label>RoadClearanceHeightNormal</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RoadRoute"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#RoadClass"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/cl"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#notEqual"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="https://w3id.org/BEDRO/cl"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>agricultural road</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#InfrastructureRouteClearanceHeight"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r"/>
                        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.70</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Liegt ein Trassenpunkt im Bereich einer anderen Trasse, ist hier eine Stützung nicht möglich</rdfs:comment>
        <rdfs:label>RouteCrossingSupportNotPossible</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRoute"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRoute"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r2"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#crossesRoute"/>
                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r1"/>
                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/r2"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RoutePoint"/>
                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#partOfRoute"/>
                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/r1"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RoutePoint"/>
                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#partOfRoute"/>
                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/r2"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#equalsRoutePoint"/>
                                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                                                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                        <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RoutePoint"/>
                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp3"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                        <rdf:first>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#partOfRoute"/>
                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp3"/>
                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/r1"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                <rdf:first>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#Station"/>
                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/s1"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                        <rdf:first>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#Station"/>
                                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp3"/>
                                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/s3"/>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:first>
                                                                                                        <rdf:rest>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                <rdf:first>
                                                                                                                    <rdf:Description>
                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#subtract"/>
                                                                                                                        <swrl:arguments rdf:parseType="Collection">
                                                                                                                            <rdf:Description rdf:about="https://w3id.org/BEDRO/diff"/>
                                                                                                                            <rdf:Description rdf:about="https://w3id.org/BEDRO/s1"/>
                                                                                                                            <rdf:Description rdf:about="https://w3id.org/BEDRO/s3"/>
                                                                                                                        </swrl:arguments>
                                                                                                                    </rdf:Description>
                                                                                                                </rdf:first>
                                                                                                                <rdf:rest>
                                                                                                                    <rdf:Description>
                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                        <rdf:first>
                                                                                                                            <rdf:Description>
                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                                                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#abs"/>
                                                                                                                                <swrl:arguments rdf:parseType="Collection">
                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/BEDRO/abs"/>
                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/BEDRO/diff"/>
                                                                                                                                </swrl:arguments>
                                                                                                                            </rdf:Description>
                                                                                                                        </rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                            <rdf:Description>
                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                                <rdf:first>
                                                                                                                                    <rdf:Description>
                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRouteWidth"/>
                                                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r2"/>
                                                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/b"/>
                                                                                                                                    </rdf:Description>
                                                                                                                                </rdf:first>
                                                                                                                                <rdf:rest>
                                                                                                                                    <rdf:Description>
                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                                        <rdf:first>
                                                                                                                                            <rdf:Description>
                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                                                                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#divide"/>
                                                                                                                                                <swrl:arguments>
                                                                                                                                                    <rdf:Description>
                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                        <rdf:first rdf:resource="https://w3id.org/BEDRO/bhalf"/>
                                                                                                                                                        <rdf:rest>
                                                                                                                                                            <rdf:Description>
                                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                <rdf:first rdf:resource="https://w3id.org/BEDRO/b"/>
                                                                                                                                                                <rdf:rest>
                                                                                                                                                                    <rdf:Description>
                                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first>
                                                                                                                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                                                    </rdf:Description>
                                                                                                                                                                </rdf:rest>
                                                                                                                                                            </rdf:Description>
                                                                                                                                                        </rdf:rest>
                                                                                                                                                    </rdf:Description>
                                                                                                                                                </swrl:arguments>
                                                                                                                                            </rdf:Description>
                                                                                                                                        </rdf:first>
                                                                                                                                        <rdf:rest>
                                                                                                                                            <rdf:Description>
                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                                                <rdf:first>
                                                                                                                                                    <rdf:Description>
                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                                                                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                                                                                                                        <swrl:arguments rdf:parseType="Collection">
                                                                                                                                                            <rdf:Description rdf:about="https://w3id.org/BEDRO/bhalf"/>
                                                                                                                                                            <rdf:Description rdf:about="https://w3id.org/BEDRO/abs"/>
                                                                                                                                                        </swrl:arguments>
                                                                                                                                                    </rdf:Description>
                                                                                                                                                </rdf:first>
                                                                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                            </rdf:Description>
                                                                                                                                        </rdf:rest>
                                                                                                                                    </rdf:Description>
                                                                                                                                </rdf:rest>
                                                                                                                            </rdf:Description>
                                                                                                                        </rdf:rest>
                                                                                                                    </rdf:Description>
                                                                                                                </rdf:rest>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:rest>
                                                                                                    </rdf:Description>
                                                                                                </rdf:rest>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#SupportNotPossible"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp3"/>
                        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Wenn zwei Punkte aus unterschiedlichen Trassen an derselben Stelle liegen (unabhängig von ihrer Höhe), dann sind sie &quot;gleich&quot; und die Trassen kreuzen sich.</rdfs:comment>
        <rdfs:label>RouteCrossing</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRoute"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r1"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRoute"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r2"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRouteName"/>
                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r1"/>
                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/n1"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#notEqual"/>
                                                <swrl:arguments rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://w3id.org/BEDRO/n1"/>
                                                    <rdf:Description rdf:about="https://w3id.org/BEDRO/n2"/>
                                                </swrl:arguments>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#InfrastructureRouteName"/>
                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r2"/>
                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/n2"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RoutePoint"/>
                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#partOfRoute"/>
                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/r1"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                <swrl:classPredicate rdf:resource="https://w3id.org/BCore#RoutePoint"/>
                                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#partOfRoute"/>
                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/r2"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                        <rdf:first>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#LocalX"/>
                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/x"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                <rdf:first>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#LocalY"/>
                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/y"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                        <rdf:first>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#LocalX"/>
                                                                                                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                                                                                                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/x"/>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:first>
                                                                                                        <rdf:rest>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                <rdf:first>
                                                                                                                    <rdf:Description>
                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#LocalY"/>
                                                                                                                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                                                                                                                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/y"/>
                                                                                                                    </rdf:Description>
                                                                                                                </rdf:first>
                                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:rest>
                                                                                                    </rdf:Description>
                                                                                                </rdf:rest>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#equalsRoutePoint"/>
                        <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/rp1"/>
                        <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/rp2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BCore#crossesRoute"/>
                                <swrl:argument1 rdf:resource="https://w3id.org/BEDRO/r1"/>
                                <swrl:argument2 rdf:resource="https://w3id.org/BEDRO/r2"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>RiZ-ING Kap 7 ohne Fußweg: Zuweisung der Dimensionen</rdfs:comment>
        <rdfs:label>CAP_Kap7Standard</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://w3id.org/brcomp#Cap"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/tim.noack/ontologies/BEDRO/c"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://w3id.org/BEDRO#CAPxxXXg00"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/tim.noack/ontologies/BEDRO/c"/>
                                <swrl:argument2>OuterCap_Standard_CU</swrl:argument2>
                            </rdf:Description>
                        </rdf:first>
