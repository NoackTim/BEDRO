        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Breite der Zone unter der Brücke</rdfs:comment>
        <rdfs:comment>[m]</rdfs:comment>
    </owl:DatatypeProperty>
    


