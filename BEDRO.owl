    <!-- https://w3id.org/brcomp#Cap -->


    <owl:Class rdf:about="https://w3id.org/brcomp#Cap">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brcomp#Cap"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/BEDRO#CAPxxXXn02"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.075</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/BCore#EquipmentComponent"/>
        <rdfs:label xml:lang="de">Kappe</rdfs:label>
    </owl:Class>
    


