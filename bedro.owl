        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Colour of the component</rdfs:comment>
        <rdfs:comment xml:lang="en">Declaration in words (e.g. &quot;blue&quot; or &quot;dark green&quot;) or Hex-Code (&quot;#0000ff&quot; or &quot;#008800&quot;)</rdfs:comment>
        <rdfs:comment xml:lang="de">Farbe des Bauteils</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXp00 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXp00">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="de">Position des Bauteils senkrecht zur Trasse (Index)</rdfs:comment>
        <rdfs:comment xml:lang="en">Position of the component perpendicular to the alignment (index)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXq00 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXq00">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Normal distance of the component perpendicular to alignment (positive to the right)</rdfs:comment>
        <rdfs:comment xml:lang="de">Normaldistanz des Bauteils zur Trasse (positiv nach rechts)</rdfs:comment>
        <rdfs:comment>[m]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXs00 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXs00">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Kilometrierung des Bauteilbeginns (Stationierung)</rdfs:comment>
        <rdfs:comment xml:lang="en">Station of the component beginning (kilometer of route)</rdfs:comment>
        <rdfs:comment>[m]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bedro#XXXxxXXz00 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bedro#XXXxxXXz00">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Altitude of the component</rdfs:comment>
        <rdfs:comment xml:lang="de">Höhe des Bauteils über NN</rdfs:comment>
        <rdfs:comment>[m AMSL]</rdfs:comment>
    </owl:DatatypeProperty>
    


