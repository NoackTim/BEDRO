    <!-- https://w3id.org/brcomp#Cap -->


    <owl:Class rdf:about="https://w3id.org/brcomp#Cap">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brcomp#Cap"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/bedro#CAPxxXXn02"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.075</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/comp#EquipmentComponent"/>
        <rdfs:comment xml:lang="de">Kappe/ Randbalken</rdfs:comment>
        <rdfs:label xml:lang="en">cap/ bridge cap/ edge beam/ rim beam</rdfs:label>
    </owl:Class>
    


